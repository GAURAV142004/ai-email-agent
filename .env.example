NEXT_PUBLIC_ORG_DOMAIN=

# Security
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# SLA Thresholds (minutes)
SLA_GREEN_MINUTES=120
SLA_YELLOW_MINUTES=480
SLA_RED_MINUTES=1440

# Gmail SMTP for invite emails
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
NEXT_PUBLIC_APP_URL=
APP_NAME=
